mainmenu "Launch controller UI"

config APP_SAT_SIM
	bool "Simulated satellites and LoRa link"
	default y
	help
	  Replace the LoRa link with an in-process satellite simulator.
	  Fault injection is available through the "sat" shell command.

config APP_PREARM_CONTINUITY
	bool "Satellites report continuity while disarmed"
	default y
	help
	  The satellites' continuity readings are real before arming, so the
	  main list shows them. Without it the list shows "?" until the
	  pads are armed, and continuity is only judged from the armed
	  readings. The satellite firmware measures through V_TEST while
	  disarmed, one output every 0.65 s or so.

config APP_ARMED_BEEP
	bool "Click every 2 s while armed"
	default y
	help
	  The buzzer clicks every 2 s while pads are armed, so nobody near
	  the controller can miss it. Arming, disarming, a launch, a fault
	  and a refused button have their tunes either way.

config APP_POLL_PERIOD_MS
	int "Heartbeat poll period in milliseconds"
	default 1200
	help
	  How often the controller polls its satellites when it has nothing
	  new to tell them. Keep it well below LINK_SAT_SAFE_TIMEOUT_MS: a
	  satellite goes SAFE after that long without a poll.

config APP_CMD_RETRY_MS
	int "Command retry period in milliseconds"
	default 300
	help
	  While a command (ARM, DISARM, FIRE, a valve change) has not been
	  acknowledged by the satellite's status, the controller polls this
	  often (plus up to 100 ms of jitter) instead of the heartbeat period.

config APP_ARM_TIMEOUT_S
	int "Arm timeout in seconds"
	default 60
	help
	  Operator inactivity after which the controller disarms. FILL and
	  VENT restart it, and it is paused while a hybrid pad is filling.

config APP_FIRE_HOLD_MS
	int "Fire button hold time in milliseconds"
	default 1000
	help
	  The fire control must be held continuously for this long
	  before the fire command is sent.

config APP_IGNLOG_CACHE
	int "Ignition log records cached"
	default 8
	help
	  Records downloaded from the satellites' ignition logs that the
	  controller keeps, for its diagnostics view and for the browser
	  tool over mcumgr; the least recently used goes first. Each takes
	  32 + 2 * APP_IGNLOG_MAX_SAMPLES bytes of DRAM, which is nearly
	  full on the ESP32-S3 (the PSRAM is not enabled): 8 hold one
	  satellite's whole log in some 17 KB.

config APP_IGNLOG_MAX_SAMPLES
	int "Samples per ignition log record"
	default 1024
	help
	  The largest record the controller accepts; at least the
	  satellite's SAT_IGNLOG_MAX_SAMPLES.

rsource "../common/link/Kconfig"

source "Kconfig.zephyr"

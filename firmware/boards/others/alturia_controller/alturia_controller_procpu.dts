/*
 * Alturia Launch Control controller, rev A
 * (hardware/controller/pcb, ESP32-S3-WROOM-1-N16R2).
 *
 * Console and shell are on USB-C, which goes straight to the ESP32-S3's
 * USB Serial/JTAG. UART0's pins drive the LCD, so there is no UART.
 *
 * The controls are pushbuttons to GND with no external pull-ups. The front
 * panel has no arm key switch.
 */
/dts-v1/;

#include <espressif/esp32s3/esp32s3.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/lora/sx126x.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <espressif/partitions_0x0_amp_16M.dtsi>
#include "alturia_controller-pinctrl.dtsi"

/ {
	model = "Alturia Launch Control controller";
	compatible = "alturia,controller";

	aliases {
		led0 = &status_led;
		lora0 = &lora;
		buzzer = &buzzer;
		watchdog0 = &wdt0;
		fuel-gauge0 = &fuel_gauge;
		charger0 = &charger;
	};

	chosen {
		zephyr,sram = &sram1;
		zephyr,console = &usb_serial;
		zephyr,shell-uart = &usb_serial;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,display = &sharp_lcd;
	};

	leds {
		compatible = "gpio-leds";

		status_led: status_led {
			gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>;	/* IO42, STATUS_LED */
		};
	};

	/* Passive magnetic buzzer QMB-09B-03; it needs a tone, not a level. */
	buzzer: buzzer {
		compatible = "pwm-buzzer";
		pwms = <&ledc0 0 PWM_HZ(4000) PWM_POLARITY_NORMAL>;	/* IO46 */
	};

	/* Key codes are the ones the controller_ui app listens for. */
	ctrl_keys: ctrl_keys {
		compatible = "gpio-keys";
		debounce-interval-ms = <20>;

		/* Delock 22032 pushbuttons on J3 / J2 */
		arm_button {
			gpios = <&gpio0 6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;	/* KEY_ARM */
			zephyr,code = <INPUT_KEY_A>;
		};

		fire_button {
			gpios = <&gpio0 5 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;	/* KEY_FIRE */
			zephyr,code = <INPUT_KEY_SPACE>;
		};

		fill_button {
			gpios = <&gpio0 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;	/* KEY_FILL */
			zephyr,code = <INPUT_KEY_F>;
		};

		vent_button {
			gpios = <&gpio0 8 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;	/* KEY_VENT */
			zephyr,code = <INPUT_KEY_V>;
		};

		/* D-pad SW1..SW6 */
		key_up {
			gpios = <&gpio0 1 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;	/* KEY_UP */
			zephyr,code = <INPUT_KEY_UP>;
		};

		key_down {
			gpios = <&gpio0 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;	/* KEY_DOWN */
			zephyr,code = <INPUT_KEY_DOWN>;
		};

		key_left {
			gpios = <&gpio0 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;	/* KEY_LEFT */
			zephyr,code = <INPUT_KEY_LEFT>;
		};

		key_right {
			gpios = <&gpio0 7 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;	/* KEY_RIGHT */
			zephyr,code = <INPUT_KEY_RIGHT>;
		};

		key_enter {
			gpios = <&gpio0 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;	/* KEY_ENTER, BOOT strap */
			zephyr,code = <INPUT_KEY_ENTER>;
		};

		key_back {
			gpios = <&gpio0 9 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;	/* KEY_BACK */
			zephyr,code = <INPUT_KEY_BACK>;
		};

		/* SW101 through Q105, 100k pull-up on board. Held for 6-9 s, the
		 * latch switches off by itself. A press held since power-on is
		 * not reported: gpio-keys only reports changes.
		 */
		power_button {
			gpios = <&gpio0 18 GPIO_ACTIVE_LOW>;	/* PWR_BTN */
			zephyr,code = <INPUT_KEY_POWER>;
		};
	};

	zephyr,user {
		/* Soft power latch (power_latch sheet): PWR_OFF high drops the
		 * 3V3_EN latch, unless the power button holds it.
		 */
		pwr-off-gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
		/* BQ24296M PG: low while USB power is good */
		usb-pgood-gpios = <&gpio1 9 GPIO_ACTIVE_LOW>;	/* IO41 */
	};
};

/* 160 MHz instead of 240: the UI and the link need far less, and the CPU
 * mostly sleeps, so it is the awake current that counts.
 */
&cpu0 {
	clock-frequency = <ESP32_CLK_CPU_PLL_160M>;
};

/* Wakes light sleep (CONFIG_PM) for the kernel's next timeout */
&rtc_timer {
	status = "okay";
	wakeup-source;
};

&flash0 {
	reg = <0x0 DT_SIZE_M(16)>;
	ranges = <0x0 0x0 DT_SIZE_M(16)>;
};

&usb_serial {
	status = "okay";
};

&gpio0 {
	status = "okay";
	gpio-line-names = "KEY_ENTER", "KEY_UP", "KEY_LEFT", "KEY_FILL",
			  "KEY_DOWN", "KEY_FIRE", "KEY_ARM", "KEY_RIGHT",
			  "KEY_VENT", "KEY_BACK", "LORA_NSS", "SPI_MOSI",
			  "SPI_SCK", "SPI_MISO", "LORA_BUSY", "LORA_DIO1",
			  "LORA_RST", "LORA_RF_SW", "PWR_BTN", "USB_DN",
			  "USB_DP", "PWR_OFF";
};

&gpio1 {
	status = "okay";
	gpio-line-names = "", "", "", "", "", "",
			  "I2C_SDA", "I2C_SCL", "GAUGE_ALRT", "USB_PGOOD",
			  "STATUS_LED", "LCD_SCK", "LCD_MOSI", "LCD_CS",
			  "BUZZER", "", "LCD_DISP";
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";

	fuel_gauge: max17048@36 {
		compatible = "maxim,max17048";
		reg = <0x36>;
	};

	/* Programmed by the driver at boot (CONFIG_CHARGER): 0.25 C for the
	 * 4 Ah 606090 cell, and no I2C watchdog, so the charger stays in host
	 * mode and keeps its input limit.
	 */
	charger: bq24296m@6b {
		compatible = "ti,bq24296m";
		reg = <0x6b>;
		constant-charge-current-max-microamp = <1024000>;
		constant-charge-voltage-max-microvolt = <4208000>;
		watchdog-timeout-ms = <0>;
	};
};

/* Wio-SX1262. DIO2 selects TX inside the module, RF_SW powers the switch,
 * which the native driver drives as antenna-enable.
 */
&spi2 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	pinctrl-0 = <&spim2_default>;
	pinctrl-names = "default";
	cs-gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;	/* LORA_NSS, 10k pull-up */

	lora: sx1262@0 {
		compatible = "semtech,sx1262";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(8)>;
		reset-gpios = <&gpio0 16 GPIO_ACTIVE_LOW>;	/* LORA_RST */
		busy-gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;	/* LORA_BUSY */
		dio1-gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;	/* LORA_DIO1 */
		antenna-enable-gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;	/* LORA_RF_SW */
		dio2-tx-enable;
		dio3-tcxo-voltage = <SX126X_DIO3_TCXO_1V8>;
		tcxo-power-startup-delay-ms = <5>;
	};
};

/* Adafruit 4694 (LS027B7DH01, 400x240). EXTCOMIN and EXTMODE are open, so
 * VCOM is inverted over SPI. CS has a 10k pull-down.
 */
&spi3 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	pinctrl-0 = <&spim3_default>;
	pinctrl-names = "default";
	cs-gpios = <&gpio1 13 GPIO_ACTIVE_HIGH>;	/* IO45, LCD_CS */

	sharp_lcd: ls0xx@0 {
		compatible = "sharp,ls0xx";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(2)>;
		width = <400>;
		height = <240>;
		disp-en-gpios = <&gpio1 16 GPIO_ACTIVE_HIGH>;	/* IO48, LCD_DISP */
		serial-vcom-inversion;
	};
};

&ledc0 {
	status = "okay";
	pinctrl-0 = <&ledc0_default>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;

	channel0@0 {
		reg = <0x0>;
		timer = <0>;
	};
};

&wdt0 {
	status = "okay";
};

&trng0 {
	status = "okay";
};

&timer0 {
	status = "disabled";
};

&timer1 {
	status = "disabled";
};

&timer2 {
	status = "disabled";
};

&timer3 {
	status = "disabled";
};

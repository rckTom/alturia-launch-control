/*
 * The satellite on native_sim, as a node of the radio network simulator
 * (tools/radiosim). Every output the real board drives is a pin of the
 * emulated gpio0 so the simulator can show it; the ADCs are emulators, and
 * there is no INA226 (rail.c reads a quiet rail without it).
 *
 *   gpio0  0      status LED (the board's led0)
 *          1-6    high-side enables EN_H1..6
 *          7-12   low-side gates EN_L1..6
 *          13-16  HS latch, HS diagnostics, arm pump, watchdog
 *          17-22  channel LEDs 1..6, which also show the pairing pattern
 *          23     pairing button (the continuity button on the board)
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	aliases {
		chan-led0 = &chan_led1;
		chan-led1 = &chan_led2;
		chan-led2 = &chan_led3;
		chan-led3 = &chan_led4;
		chan-led4 = &chan_led5;
		chan-led5 = &chan_led6;
	};

	pyro_enables {
		compatible = "gpio-leds";
		en_h1: en_h1 { gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>; };
		en_h2: en_h2 { gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>; };
		en_h3: en_h3 { gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>; };
		en_h4: en_h4 { gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>; };
		en_h5: en_h5 { gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>; };
		en_h6: en_h6 { gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>; };
		en_l1: en_l1 { gpios = <&gpio0 7 GPIO_ACTIVE_HIGH>; };
		en_l2: en_l2 { gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>; };
		en_l3: en_l3 { gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>; };
		en_l4: en_l4 { gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>; };
		en_l5: en_l5 { gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>; };
		en_l6: en_l6 { gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>; };
		hs_latch: hs_latch { gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>; };
		hs_dia_en: hs_dia_en { gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>; };
		arm_pump: arm_pump { gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>; };
		wdi: wdi { gpios = <&gpio0 16 GPIO_ACTIVE_HIGH>; };
	};

	chan_leds {
		compatible = "gpio-leds";
		chan_led1: chan_led1 { gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>; };
		chan_led2: chan_led2 { gpios = <&gpio0 18 GPIO_ACTIVE_HIGH>; };
		chan_led3: chan_led3 { gpios = <&gpio0 19 GPIO_ACTIVE_HIGH>; };
		chan_led4: chan_led4 { gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>; };
		chan_led5: chan_led5 { gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>; };
		chan_led6: chan_led6 { gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>; };
	};

	pair_keys {
		compatible = "gpio-keys";

		pair_button: pair_button {
			gpios = <&gpio0 23 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	/* 24-bit continuity ADC and 12-bit rail ADC. */
	adc_continuity: adc_continuity {
		compatible = "zephyr,adc-emul";
		nchannels = <6>;
		ref-internal-mv = <2500>;
		#io-channel-cells = <1>;
		status = "okay";
	};

	adc_rails: adc_rails {
		compatible = "zephyr,adc-emul";
		nchannels = <8>;
		ref-external0-mv = <4096>;
		#io-channel-cells = <1>;
		status = "okay";
	};
};

/*
 * native_sim: emulates a 400x240 1-bit Sharp Memory LCD (LS027B7DH01 class)
 * in an SDL window. There is no touch; mouse and keyboard stand in for the
 * controller's physical controls.
 *
 *   Arrows, Enter   D-pad (mouse wheel and click also work as up/down, OK)
 *   Esc    BACK button (hold to leave the button test)
 *   K      controller arm key (latching, press to toggle)
 *   A      ARM button
 *   F      FILL button (hybrid pads, toggle)
 *   V      VENT button (hybrid pads, toggle)
 *   Space  FIRE button (hold)
 *   P      power button
 *
 * Simulator only (fault injection, not a controller control):
 *   F1, F2  toggle the radio link of satellite A, B
 */

#include <zephyr/dt-bindings/display/panel.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

&sdl_dc {
	width = <400>;
	height = <240>;
	pixel-format = <PANEL_PIXEL_FORMAT_MONO01>;
};

&gpio0 {
	ngpios = <15>;

	sdl_gpio {
		status = "okay";
		compatible = "zephyr,gpio-emul-sdl";
		/*
		 * USB HID scancodes, indexed by pin. Pin 0 is led0, so it gets
		 * the unused code 0.
		 * K=14 Space=44 Esc=41 A=4 F=9 V=25 Up=82 Down=81 Enter=40
		 * F1=58 F2=59 Left=80 Right=79 P=19
		 */
		scancodes = <0 14 44 41 4 9 25 82 81 40 58 59 80 79 19>;
	};
};

/ {
	ctrl_keys: ctrl_keys {
		compatible = "gpio-keys";

		arm_key {
			gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_K>;
		};

		fire_button {
			gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_SPACE>;
		};

		back_button {
			gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_BACK>;
		};

		arm_button {
			gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_A>;
		};

		fill_button {
			gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_F>;
		};

		vent_button {
			gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_V>;
		};

		key_up {
			gpios = <&gpio0 7 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_UP>;
		};

		key_down {
			gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_DOWN>;
		};

		key_select {
			gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_ENTER>;
		};

		key_left {
			gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_LEFT>;
		};

		key_right {
			gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_RIGHT>;
		};

		power_button {
			gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_POWER>;
		};
	};

	/* Handled by the satellite simulator, see sat_sim.c */
	sim_keys {
		compatible = "gpio-keys";

		sat_a_link {
			gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_F1>;
		};

		sat_b_link {
			gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_F2>;
		};
	};
};

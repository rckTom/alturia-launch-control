	(text_box "Fault Test Sequence\n1: Disarm (V_PYRO = 0V), ENABLE_LOW_SIDE = FALSE, ENABLE_HIGH_SIDE = FALSE, V_TEST=3.3V\n2: IF V_PYRO > 0V -> ARMING switch failed to short\n3: IF SENSE_H << 0.75V -> LOW SIDE FAILED\n4: IF SENSE_H ~ 0.75V -> OPEN LOAD\n5: ENABLE_LOW_SIDE = TRUE\n6: IF SENSE_H << 0.75V -> IGNITOR PRESENT\n7: IF SENSE_H ~0.75V -> NO INGNITOR PRESENT\n8: ENABLE_LOW_SIDE = FALSE\n9: ARM (V_PYRO max 15V), ENABLE_HIGH_SIDE = FALSE\n10: IF SENSE_H ~ V_PYRO * 1/3.3 -> HIGH SIDE FAILED\n11: IF SENSE_H ~ 0.75V -> HIGH SIDE OK\n12: ENABLE_HIGH_SIDE = FALSE"
		(exclude_from_sim no)

*.blend
*.blend1
*.glb

# KiCad
*-backups/
*.kicad_prl
~*.lck
*.bak
fp-info-cache
*.net
_autosave-*
*-unsaved-export-*

# CalculiX working directories
hardware/controller/sim/**/work/

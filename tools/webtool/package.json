{
  "name": "alturia-webtool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "test": "esbuild src/smp/smp.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/smp.test.mjs && node node_modules/.cache/smp.test.mjs && esbuild src/smp/ignlog.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ignlog.test.mjs && node node_modules/.cache/ignlog.test.mjs",
    "firmware": "esbuild scripts/firmware.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/firmware.mjs && node node_modules/.cache/firmware.mjs",
    "simtest": "esbuild scripts/simtest.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/simtest.mjs && node node_modules/.cache/simtest.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/w3c-web-serial": "^1.0.9",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
